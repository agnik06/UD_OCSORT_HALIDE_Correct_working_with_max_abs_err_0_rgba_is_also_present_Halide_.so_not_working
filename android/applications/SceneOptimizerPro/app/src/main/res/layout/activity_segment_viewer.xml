<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SegmentViewer">



        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/segment_image_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                app:srcCompat="@color/windowBackground" />

            <ImageView
                android:id="@+id/segment_mask_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="1" />

            <vizinsight.atl.ui.ToggleImageButton
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignLeft="@id/segment_image_view"
                android:layout_centerVertical="true"
                android:background="@color/windowBackground"
                android:scaleType="centerCrop"

                android:scaleX="1"
                android:scaleY="1"
                android:src="@android:drawable/ic_menu_share"
                android:text="S"
                android:textDirection="firstStrong"
                tools:layout_editor_absoluteX="wrap_content"
                tools:layout_editor_absoluteY="wrap_content" />
<!--
            <ImageView
                android:id ="@+id/refreshBtton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignRight="@id/segment_image_view"
                android:layout_centerVertical="true"
                android:background="@color/windowBackground"
                android:scaleType="centerCrop"

                android:scaleX="1"
                android:scaleY="1"
                android:src="@drawable/refresh"
                android:text="S"
                android:textDirection="firstStrong"
                tools:layout_editor_absoluteX="wrap_content"
                tools:layout_editor_absoluteY="wrap_content" />-->



        </RelativeLayout>





</androidx.constraintlayout.widget.ConstraintLayout>